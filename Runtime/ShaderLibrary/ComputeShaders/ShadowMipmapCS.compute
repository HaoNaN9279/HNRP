// 矩图（PCSS/VSSM）软阴影的 mip 链生成：
// CPU 每帧把需要更新的 map 区域按 mip 级聚合，每级一次 dispatch（与 map 数无关，最多 mip 级数次）。
// 每次 dispatch 处理一个 mip 级上的所有区域：由 mip N-1 的 2×2 平均得到 mip N。
//
// 依赖 TextureAllocator 的对齐性质：区域尺寸与偏移均为 512 的倍数，
// 故任意 mip 下不同区域不共享 texel，可逐区域独立生成。
//
// 注意：源必须声明为 RWTexture（UAV）。若声明为 Texture2DArray（SRV），
// 与目标 UAV 同属一张 texture 会被 D3D 判定为读写冲突，读取恒为 0（mip 全黑）。
// 源/目标仅 mip 不同，属非重叠子资源，UAV+UAV 合法。
#pragma kernel CSGenerateMip

// 单个待更新区域（布局须与 C# ShadowMipRegion 一致，8 × uint = 32 字节）。
struct ShadowMipRegion
{
    uint slice;         // 所在 slice
    uint srcOriginX;    // 源 mip 区域原点（源 mip texel 坐标）
    uint srcOriginY;
    uint destOriginX;   // 目标 mip 区域原点（目标 mip texel 坐标）
    uint destOriginY;
    uint destSize;      // 目标 mip 区域边长
    uint groupOffset;   // 该区域在本级 dispatch 内的起始线性组号
    uint padding;
};

RWTexture2DArray<float2> _SourceMip;
RWTexture2DArray<float2> _DestMip;
StructuredBuffer<ShadowMipRegion> _Regions;
uint _RegionCount;

[numthreads(8, 8, 1)]
void CSGenerateMip(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    // 线性组号：跨 x / y 两维展开，规避单维 65535 组上限。
    // CPU 侧 x 恒为 min(totalGroups, 65535)，故该公式恒成立。
    uint gid = groupId.x + groupId.y * 65535u;

    // 区域按 groupOffset 升序，二分查找到 gid 所属区域。
    int lo = 0;
    int hi = (int)_RegionCount - 1;
    int found = -1;
    while (lo <= hi)
    {
        int mid = (lo + hi) >> 1;
        if (_Regions[mid].groupOffset <= gid)
        {
            found = mid;
            lo = mid + 1;
        }
        else
        {
            hi = mid - 1;
        }
    }

    if (found < 0)
    {
        return;
    }

    ShadowMipRegion region = _Regions[found];
    uint groupsPerAxis = (region.destSize + 7u) / 8u;
    uint localGroup = gid - region.groupOffset;
    uint gx = localGroup % groupsPerAxis;
    uint gy = localGroup / groupsPerAxis;

    uint2 local = uint2(gx * 8u + groupThreadId.x, gy * 8u + groupThreadId.y);
    if (local.x >= region.destSize || local.y >= region.destSize)
    {
        return;
    }

    int2 source = int2(region.srcOriginX + local.x * 2u, region.srcOriginY + local.y * 2u);
    float2 m00 = _SourceMip.Load(int4(source.x,     source.y,     region.slice, 0));
    float2 m10 = _SourceMip.Load(int4(source.x + 1, source.y,     region.slice, 0));
    float2 m01 = _SourceMip.Load(int4(source.x,     source.y + 1, region.slice, 0));
    float2 m11 = _SourceMip.Load(int4(source.x + 1, source.y + 1, region.slice, 0));

    _DestMip[int3(region.destOriginX + local.x, region.destOriginY + local.y, region.slice)] =
        (m00 + m10 + m01 + m11) * 0.25;
}
